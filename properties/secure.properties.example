# =============================================================================
# EXEMPLO - copie este arquivo para secure.properties e preencha os valores
# =============================================================================

# === E-mail remetente ===
email_envio=seu_email@gmail.com
senha_envio=sua_senha_de_app

# === Oracle - dados de conexão com o banco ===
oracle_host=servidor.dominio.com
oracle_port=1521
oracle_service=NOME_SERVICE
oracle_user=usuario
oracle_password=senha

# === APIs externas - APIKEY (sensível) ===
# Cadastre/edite as APIs pela interface (Configurações → Requisição API).
# Os metadados (url, método, parâmetro, dica, body) ficam em config.properties;
# apenas a APIKEY é gravada aqui, no formato:
# api.NOME_API.apikey=chave-secreta
